LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key
# This model is available under Groq Free Plan rate limits; Groq models do not use a :free suffix.
GROQ_MODEL=openai/gpt-oss-20b

# Optional OpenRouter configuration; set LLM_PROVIDER=openrouter to use it.
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=openrouter/free
